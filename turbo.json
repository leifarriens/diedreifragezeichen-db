{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**", "build/**"],
      "passThroughEnv": ["RESEND_API_KEY", "RESEND_FROM_EMAIL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["RESEND_API_KEY", "RESEND_FROM_EMAIL"]
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/.eslintcache"]
    },
    "test": {
      "dependsOn": ["^topo", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "dependsOn": ["^topo", "^build"],
      "interactive": true,
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["**/.env*"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI"]
}
