{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "**/.cache/**": true,
    "**/.git": true,
    "**/.turbo/**": true,
    "**/coverage/**": true
  },
  "conventionalCommits.scopes": ["db", "core", "user-api", "website", "mobile"],
  "tailwindCSS.experimental.classRegex": [
    ["tv\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ]
}
