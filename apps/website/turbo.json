{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:e2e": {
      "cache": false,
      "env": ["PLAYWRIGHT_BASE_URL", "VERCEL_AUTOMATION_BYPASS_SECRET"]
    },
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CRON_SECRET",
        "DATABASE_URL",
        "DDFDB_ARCHIV_API_URL",
        "MONGODB_URI",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "TRPC_CORS_ORIGINS"
      ]
    },
    "dev": {
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CRON_SECRET",
        "DATABASE_URL",
        "DDFDB_ARCHIV_API_URL",
        "MONGODB_URI",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "TRPC_CORS_ORIGINS"
      ]
    }
  }
}
