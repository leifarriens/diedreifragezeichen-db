{
  "name": "@ddfdb/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./archiv": {
      "types": "./dist/archiv/index.d.ts",
      "import": "./src/archiv/index.ts",
      "default": "./src/archiv/index.ts"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "git clean -xdf .cache .turbo dist",
    "dev": "tsc --watch --project tsconfig.build.json",
    "lint": "eslint --cache --cache-location .cache/.eslintcache",
    "test:watch": "vitest",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ddfdb/archiv": "workspace:*",
    "@ddfdb/user-api": "workspace:*",
    "@tanstack/react-query": "5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@ddfdb/eslint-config": "workspace:*",
    "@ddfdb/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
