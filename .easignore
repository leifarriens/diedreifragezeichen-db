# EAS uses this file instead of all .gitignore files in the repository.
# Keep workspace manifests, configs, sources, and generated API contracts.

# Dependencies and caches
node_modules/
.pnpm-store/
.cache/
.turbo/
.next/
.expo/
.vercel/
.kotlin/
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[codz]

# Build outputs and test reports
dist/
dist-ssr/
build/
out/
web-build/
coverage/
test-results/
playwright-report/
blob-report/
**/playwright/.auth/
*.tsbuildinfo
expo-env.d.ts
next-env.d.ts

# Native projects are generated by EAS Prebuild (CNG).
/apps/mobile/ios/
/apps/mobile/android/

# Local environment files and signing credentials
*.env*
!.env.example
*.local
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Logs and temporary files
logs/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.metro-health-check*
*.orig.*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Repository tooling and documentation
.git
.github/
.husky/
.vscode/
.idea/
.agents/
/docs/
/turbo/generators/

# Local archive-service data and binaries (keep services/archiv/generated/).
/services/archiv/data/
/services/archiv/archiv
/services/archiv/tmp/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.sql
